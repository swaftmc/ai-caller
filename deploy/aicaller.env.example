# Copy to /etc/aicaller.env (chmod 600, owned by root) and fill in.

# The address people open. Only this host name is accepted.
PUBLIC_URL=https://caller.example.com
# Your email. You can always sign in with it and you see the Admin page.
ADMIN_EMAIL=you@example.com

# Where the database lives. Back this folder up.
DATA_DIR=/var/lib/aicaller
# 32 random bytes in base64: openssl rand -base64 32
# Encrypts stored details and API keys. Keep a copy somewhere other than the data backups.
# Losing it makes those values unreadable.
ENCRYPTION_KEY=

# Sign-in emails through Resend (https://resend.com). MAIL_FROM must be on a domain you verified there.
# Without these, sign-in links are only printed to the server log.
RESEND_API_KEY=
MAIL_FROM=AI Caller <signin@caller.example.com>

# Caddy forwards to this address.
HOST=127.0.0.1
PORT=4317
# AICALLER_LOG_LEVEL=warn
